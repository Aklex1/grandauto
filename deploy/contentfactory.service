[Unit]
Description=Content Factory (KIE) — веб-панель и конвейер производства роликов
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/contentfactory
EnvironmentFile=/etc/contentfactory.env
ExecStart=/opt/contentfactory/venv/bin/python -m uvicorn app.main:app --host ${CF_HOST} --port ${CF_PORT} --timeout-keep-alive 75
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
LimitNOFILE=65535
StandardOutput=append:/var/lib/contentfactory/logs/app.log
StandardError=append:/var/lib/contentfactory/logs/app.log

[Install]
WantedBy=multi-user.target

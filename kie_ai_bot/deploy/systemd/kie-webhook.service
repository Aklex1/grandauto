[Unit]
Description=KIE AI YooMoney webhook for Telegram bot (:8000)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/kie_ai_bot
ExecStart=/opt/kie_ai_bot/venv/bin/gunicorn -w 2 -b 0.0.0.0:8000 --timeout 60 webhook_server:app
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kie-webhook

[Install]
WantedBy=multi-user.target

[Unit]
Description=NeuroHub App API Service (:8011)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/kie_ai_bot
ExecStart=/opt/kie_ai_bot/venv/bin/uvicorn app_api:app --host 0.0.0.0 --port 8011
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=app-api

[Install]
WantedBy=multi-user.target

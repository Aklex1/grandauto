# ============================================================================
# .env для kie_ai_bot — копируется в /opt/kie_ai_bot/.env
# Формат строгий: KEY=value, без кавычек, без пробелов вокруг "=",
# без комментариев в конце строки.
# ============================================================================

# --- Telegram ---
TELEGRAM_BOT_TOKEN=ЗАПОЛНИТЬ

# --- KIE API ---
KIE_API_KEY=ЗАПОЛНИТЬ

# --- Публичные адреса этого сервера ---
# Куда KIE присылает результаты генераций (порт 8010, поднимает main.py).
# ВАЖНО: должен быть доступен из интернета, иначе результаты не дойдут до пользователей.
CALLBACK_BASE_URL=http://89.169.38.152:8010
# API мобильного приложения (порт 8011)
APP_API_BASE_URL=http://89.169.38.152:8011

# --- YooMoney (платежи) ---
YOOMONEY_RECEIVER=ЗАПОЛНИТЬ
YOOMONEY_RECEIVER_APP=ЗАПОЛНИТЬ
YOOMONEY_SUCCESS_URL=https://genius-bot.ru/success

# --- MySQL ---
DB_HOST=ЗАПОЛНИТЬ
DB_NAME=ЗАПОЛНИТЬ
DB_USER=ЗАПОЛНИТЬ
DB_PASSWORD=ЗАПОЛНИТЬ
DB_PORT=3306
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20

# --- Redis (локальный) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- Окружение ---
ENVIRONMENT=production

# --- Наценки ---
GENERATION_MARKUP=50
SPEECH_TO_TEXT_MARKUP=0.3

# --- Сайт ---
WP_SITE_URL=https://genius-bot.ru
WP_AUTH_PAGE=/tts-login
WORDPRESS_API_URL=https://genius-bot.ru/wp-json/neurohub/v1/upload-image
WORDPRESS_API_KEY=ЗАПОЛНИТЬ

# --- SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ЗАПОЛНИТЬ
SMTP_PASSWORD=ЗАПОЛНИТЬ
SMTP_FROM_EMAIL=ЗАПОЛНИТЬ
SMTP_FROM_NAME=Neuro Hub
APP_BASE_URL=https://genius-bot.ru

# --- JWT для входа в мобильное приложение ---
JWT_SECRET=СГЕНЕРИРУЕТСЯ_АВТОМАТИЧЕСКИ

# ============================================================================
# Автопостинг: канал-источник -> KIE AI -> целевой канал
# ============================================================================
AUTOPOST_ENABLED=0
# Каналы-источники через запятую. Чужие каналы читает Telethon (см. ниже),
# в своих достаточно сделать бота администратором.
AUTOPOST_SOURCE_CHAT_IDS=-1002740687728,-1003323955323,-1002480431725,-1003066766232,-1003464475413,-1003606660289,-1003099895391,-1002506938260,-1002296204650,-1003716351258
# Канал, куда публикуем результат
AUTOPOST_TARGET_CHAT_ID=-1003337013037
# Группа обсуждений ЦЕЛЕВОГО канала — туда уходит комментарий с промптом.
# 0 — определить автоматически при старте, но лучше задать явно:
# если запрос к Telegram отвалится по таймауту, автоопределение не сработает
AUTOPOST_DISCUSSION_CHAT_ID=-1003283664081
# Референсное фото девушки, подмешивается к каждой генерации
AUTOPOST_REFERENCE_IMAGE=/opt/refer/refer.jpg
# Сколько новых постов брать с каждого канала за сутки
AUTOPOST_PER_CHANNEL_DAILY=2
# Суточный потолок публикаций. Если не задан — PER_CHANNEL_DAILY * число каналов
# AUTOPOST_DAILY_LIMIT=20
# Растягивать публикации равномерно по суткам (1) или выкладывать пачкой (0)
AUTOPOST_SPREAD_OVER_DAY=1
# Сколько ждать, пока пост долетит до группы обсуждений, секунд
AUTOPOST_DISCUSSION_WAIT=20
# Сколько раз повторять попытку отправить комментарий с промптом
AUTOPOST_COMMENT_MAX_TRIES=20
# Каталог для скачанных фото и результатов
AUTOPOST_MEDIA_DIR=/opt/kie_ai_bot/autopost_media
AUTOPOST_DB=/opt/kie_ai_bot/autopost.db
# Как часто разгребается очередь, секунды
AUTOPOST_WORKER_INTERVAL=120
# Соотношение сторон результата: auto / 1:1 / 9:16 / 3:4 / 16:9
AUTOPOST_IMAGE_SIZE=auto
AUTOPOST_OUTPUT_FORMAT=png
# Как отдавать картинки в Kie AI:
# 1 — загружать в файловое хранилище Kie (публичный адрес бота не нужен),
# 0 — отдавать ссылками на свой FastAPI (нужен доступный снаружи CALLBACK_BASE_URL)
AUTOPOST_UPLOAD_VIA_KIE=1
# Если callback от Kie не пришёл за столько минут — забрать результат опросом
AUTOPOST_POLL_AFTER_MINUTES=5

# --- Оформление поста в целевом канале ---
AUTOPOST_BOT_URL=https://t.me/Neuro_HubAI_bot?start=Sv_lana0707
# Имя бота для кнопки «Повторить это фото». Пусто — берётся из AUTOPOST_BOT_URL
AUTOPOST_BOT_USERNAME=
AUTOPOST_SITE_URL=https://genius-bot.ru/neurohub/?ref=sv07
AUTOPOST_MAX_URL=https://max.ru/join/Ba2dnqkVMbJlRI3BlvIWp95Grn7SzFESG7HxtazTosw
# Хештег, если в исходном посте своих нет
AUTOPOST_HASHTAGS=#Женский
AUTOPOST_FOOTER=⚜️⚜️⚜️⚜️⚜️⚜️⚜️⚜️

# ============================================================================
# Чтение ЧУЖОГО канала-источника через пользовательскую сессию (Telethon).
# Нужно, только если бота нельзя сделать администратором в канале-источнике.
# ============================================================================
TELETHON_ENABLED=0
# api_id и api_hash берутся на https://my.telegram.org -> API development tools
TELETHON_API_ID=
TELETHON_API_HASH=
TELETHON_SESSION=/opt/kie_ai_bot/telethon.session
# Как часто проверять канал на новые посты, секунды
TELETHON_POLL_INTERVAL=600
# Сколько последних постов забрать при первом запуске
TELETHON_BACKFILL_LIMIT=3
# Сколько постов просматривать за проход дальше
TELETHON_SCAN_LIMIT=20
# Как глубоко уходить в историю, если под свежими постами нет промпта
TELETHON_MAX_LOOKBACK=60
# Комментарий короче этого не считается промптом
TELETHON_MIN_PROMPT_LEN=40
# Слова, после которых идёт сам промпт (ищутся и в комментариях, и в подписи)
AUTOPOST_PROMPT_MARKERS=промпт,промт,prompt
# Обороты, с которых промпт обычно начинается — текст берётся вместе с ними
AUTOPOST_PROMPT_HINTS=сохрани внешность,создай изображение,создай фото,фотореалистич,фотореализм
# Подпись без маркера считается промптом начиная с такой длины
AUTOPOST_CAPTION_MIN_LEN=200

# --- Отсев рекламных постов ---
# Слова, по которым пост считается рекламным и в работу не берётся
AUTOPOST_AD_STOP_WORDS=курс,курсы,обучени,обуча,наставнич,вебинар,марафон,интенсив,мастер-класс,мастеркласс,воркшоп,тренинг,запишись,записывайся,запись на,мест осталось,успей купить,покупк,оплати,оплата,стоимость,скидк,промокод,тариф,рассрочк,ученик,ученики,разбор за,приходи учиться,продаю,продажа,бесплатный вебинар,бесплатный урок,гайд за,подписка за,реклам,advertis,по вопросам рекламы,для заказов,orders,прайс,услуги,продвижен,накрутк,трафик,сотрудничеств,vpn,впн,telegram premium,тг премиум,подписка от,в наличии,заказать,на заказ,пиши в лс,писать в лс
# Пропускать посты, если на исходном фото есть текст: любая надпись поверх фото
# считается рекламным креативом
AUTOPOST_SKIP_IMAGES_WITH_TEXT=1
# Сколько распознанных букв уже считать надписью
AUTOPOST_IMAGE_TEXT_MIN_CHARS=4
# 1 — не брать посты вообще, пока OCR не работает (строгий режим)
AUTOPOST_REQUIRE_OCR=0
TELETHON_COMMENTS_LIMIT=30

# ============================================================================
# Канал про нейросети: свои посты по плану + новости с русскоязычных порталов
# ============================================================================
NEWS_ENABLED=0
# Куда публикуем (группа «Нейросети»)
NEWS_CHAT_ID=-1001711115341
NEWS_DB=/opt/kie_ai_bot/news.db
NEWS_PLAN=/opt/kie_ai_bot/content_plan.json
# Сколько чего выходит за сутки
NEWS_PLAN_PER_DAY=1
NEWS_PER_DAY=2
# Часы публикаций в UTC. 7,12,16 — это 10:00, 15:00 и 19:00 по Москве
NEWS_SCHEDULE_HOURS=7,12,16
# Как часто сверяться с расписанием, секунды
NEWS_TICK_INTERVAL=300
# Ссылка на бота для постов из плана и призыв под новостями
NEWS_BOT_URL=https://t.me/Neuro_HubAI_bot
NEWS_BOT_CTA=Сделать фото или видео нейросетью
# Показывать название источника словом (ссылка на сторонний сайт не ставится никогда)
NEWS_SHOW_SOURCE_NAME=1
# Брать материал из общей ленты, только если тема заявлена в заголовке
NEWS_STRICT_TITLE_MATCH=1
# Подпись в конце каждого поста (можно оставить пустой)
NEWS_FOOTER=

# --- Промо-посты про сервисы сайта (с примером, сгенерированным через API) ---
PROMO_ENABLED=0
# Раз в сколько дней выходит промо-пост
PROMO_EVERY_DAYS=3
# Сколько ждать готовности примера от Kie AI, секунд
PROMO_SAMPLE_WAIT=240
